<!DOCTYPE html>
<html lang="ko" data-theme="light">

<head>
  <title>PCINS Payment Gateway API Documentation</title>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="PCINS Payment Gateway API Documentation - Hosted UI and Server-to-Server API Integration Guide." />
  <link rel="icon" href="favicon.ico" type="image/x-icon" />

  <!-- Google Fonts: Inter & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- Redoc Standalone Bundle for Hydration -->
  <script src="https://cdn.redoc.ly/redoc/latest/bundles/redoc.standalone.js"></script>

  <style>
    /* ==========================================================================
       1. Design System Tokens (Eye-Care & Soft Contrast Palette)
       ========================================================================== */
    :root {
      /* Primary Brand & Accents */
      --primary: #3b82f6;
      --primary-hover: #2563eb;
      --primary-light: #eff6ff;
      --primary-border: #bfdbfe;
      --accent: #38bdf8;
      
      /* Surface & Backgrounds (Soft Slate Tone - Non-glare) */
      --bg-body: #f8fafc;
      --bg-header: rgba(248, 250, 252, 0.94);
      --bg-card: #ffffff;
      --bg-card-hover: #f1f5f9;
      --bg-modal: #ffffff;
      --bg-code: #0f172a;
      
      /* Typography (Soft Charcoal - Reduced Eye Strain) */
      --text-main: #1e293b;
      --text-muted: #64748b;
      --text-dim: #94a3b8;
      
      /* Borders & Dividers */
      --border-color: #e2e8f0;
      --border-strong: #cbd5e1;
      
      /* Shadows */
      --shadow-sm: 0 1px 3px 0 rgba(15, 23, 42, 0.06), 0 1px 2px -1px rgba(15, 23, 42, 0.06);
      --shadow-md: 0 4px 6px -1px rgba(15, 23, 42, 0.08), 0 2px 4px -2px rgba(15, 23, 42, 0.06);
      --shadow-lg: 0 10px 15px -3px rgba(15, 23, 42, 0.08), 0 4px 6px -4px rgba(15, 23, 42, 0.04);
      --shadow-modal: 0 20px 25px -5px rgba(15, 23, 42, 0.15), 0 8px 10px -6px rgba(15, 23, 42, 0.1);
    }

    [data-theme="dark"] {
      /* Primary Brand & Accents (Pastel Soft Blue) */
      --primary: #60a5fa;
      --primary-hover: #93c5fd;
      --primary-light: rgba(96, 165, 250, 0.14);
      --primary-border: rgba(96, 165, 250, 0.28);
      --accent: #38bdf8;
      
      /* Surface & Backgrounds (Deep Slate Charcoal - Non-harsh) */
      --bg-body: #0f172a;
      --bg-header: rgba(15, 23, 42, 0.92);
      --bg-card: #1e293b;
      --bg-card-hover: #273549;
      --bg-modal: #1e293b;
      --bg-code: #0b1120;
      
      /* Typography (Soft Silver Off-White - Reduced Glare) */
      --text-main: #e2e8f0;
      --text-muted: #94a3b8;
      --text-dim: #64748b;
      
      /* Borders & Dividers */
      --border-color: #334155;
      --border-strong: #475569;
      
      /* Shadows */
      --shadow-sm: 0 1px 3px 0 rgba(0, 0, 0, 0.3);
      --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.35);
      --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.4);
      --shadow-modal: 0 25px 50px -12px rgba(0, 0, 0, 0.6);
    }

    /* ==========================================================================
       2. Global Reset & Base Typography
       ========================================================================== */
    * {
      box-sizing: border-box;
      transition: background-color 0.2s ease, border-color 0.2s ease, color 0.15s ease;
    }

    body {
      margin: 0;
      padding: 0;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      font-size: 14.5px;
      line-height: 1.6;
      color: var(--text-main);
      background-color: var(--bg-body);
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 7px;
      height: 7px;
    }
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      background: var(--border-strong);
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: var(--text-dim);
    }

    /* Top Scroll Progress Indicator */
    #scroll-progress {
      position: fixed;
      top: 0;
      left: 0;
      height: 3px;
      background: linear-gradient(90deg, #3b82f6, #38bdf8, #10b981);
      width: 0%;
      z-index: 10000;
      transition: width 0.1s ease;
    }

    /* ==========================================================================
       3. Header & Brand Navigation
       ========================================================================== */
    .pcins-top-bar {
      position: sticky;
      top: 0;
      z-index: 1000;
      height: 64px;
      background: var(--bg-header);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 24px;
      box-shadow: var(--shadow-sm);
    }

    .pcins-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: var(--text-main);
      white-space: nowrap;
    }

    .pcins-logo-badge {
      background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
      color: #ffffff;
      font-weight: 800;
      font-size: 14px;
      letter-spacing: 0.5px;
      padding: 6px 12px;
      border-radius: 8px;
      box-shadow: 0 2px 6px rgba(59, 130, 246, 0.28);
      white-space: nowrap;
    }

    .pcins-brand-title {
      font-size: 16px;
      font-weight: 700;
      color: var(--text-main);
      letter-spacing: -0.2px;
      white-space: nowrap;
    }

    .pcins-version-tag {
      background: var(--primary-light);
      color: var(--primary);
      font-size: 11px;
      font-weight: 700;
      padding: 3px 8px;
      border-radius: 9999px;
      border: 1px solid var(--primary-border);
      white-space: nowrap;
    }

    .pcins-spec-tag {
      background: #ecfdf5;
      color: #059669;
      font-size: 11px;
      font-weight: 700;
      padding: 3px 8px;
      border-radius: 9999px;
      border: 1px solid #a7f3d0;
      white-space: nowrap;
    }
    [data-theme="dark"] .pcins-spec-tag {
      background: rgba(16, 185, 129, 0.12);
      color: #34d399;
      border-color: rgba(16, 185, 129, 0.25);
    }

    .pcins-nav-links {
      display: flex;
      align-items: center;
      gap: 10px;
      white-space: nowrap;
    }

    /* Test Account Copy Badges */
    .pcins-account-badge {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      color: var(--text-muted);
      background: var(--bg-card);
      padding: 6px 12px;
      border-radius: 8px;
      border: 1px solid var(--border-color);
      cursor: pointer;
      user-select: none;
      transition: all 0.2s ease;
      font-family: 'JetBrains Mono', monospace;
      box-shadow: var(--shadow-sm);
      white-space: nowrap;
    }

    .pcins-account-badge:hover {
      border-color: var(--primary);
      color: var(--primary);
      background: var(--primary-light);
      transform: translateY(-1px);
    }

    .pcins-account-badge .badge-label {
      font-weight: 700;
      color: var(--text-main);
      white-space: nowrap;
    }

    .pcins-account-badge .copy-icon {
      opacity: 0.6;
      font-size: 11px;
    }

    /* Action Buttons */
    .pcins-action-btn {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      font-weight: 600;
      color: var(--text-main);
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      padding: 6px 14px;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.2s ease;
      box-shadow: var(--shadow-sm);
      white-space: nowrap;
    }

    .pcins-action-btn:hover {
      border-color: var(--primary);
      background: var(--primary-light);
      color: var(--primary);
      transform: translateY(-1px);
    }

    .pcins-action-btn kbd {
      background: var(--border-color);
      color: var(--text-muted);
      font-size: 11px;
      padding: 2px 6px;
      border-radius: 4px;
      font-family: inherit;
    }

    .pcins-theme-toggle {
      width: 38px;
      height: 38px;
      padding: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 8px;
      border: 1px solid var(--border-color);
      background: var(--bg-card);
      color: var(--text-main);
      cursor: pointer;
      font-size: 16px;
      transition: all 0.2s ease;
      box-shadow: var(--shadow-sm);
    }

    .pcins-theme-toggle:hover {
      border-color: var(--primary);
      background: var(--primary-light);
      color: var(--primary);
      transform: translateY(-1px);
    }

    /* ==========================================================================
       4. Redoc UI Overrides & Readability Enhancements (No More 2-Line Wrapping)
       ========================================================================== */
    .redoc-wrap {
      font-family: 'Inter', sans-serif !important;
      background-color: var(--bg-body) !important;
    }

    /* Left Sidebar Menu Width & Text Wrapping Prevention */
    [role="navigation"] {
      width: 285px !important;
      min-width: 285px !important;
      background-color: var(--bg-body) !important;
      border-right: 1px solid var(--border-color) !important;
    }

    [role="navigation"] label {
      color: var(--text-muted) !important;
      font-weight: 600 !important;
      font-size: 13.5px !important;
      word-break: keep-all !important;
      line-height: 1.35 !important;
    }

    [role="navigation"] li.active > label,
    [role="navigation"] li.active > a {
      color: var(--primary) !important;
      background-color: var(--primary-light) !important;
    }

    /* Main Content Area */
    .api-content {
      background-color: var(--bg-body) !important;
      max-width: none !important;
    }

    .api-content h1, 
    .api-content h2, 
    .api-content h3, 
    .api-content h4 {
      color: var(--text-main) !important;
      font-weight: 700 !important;
      letter-spacing: -0.02em !important;
      word-break: keep-all !important;
    }

    .api-content p,
    .api-content li {
      color: var(--text-main) !important;
      line-height: 1.65 !important;
      word-break: keep-all !important;
    }

    /* --- [KEY FIX 1] Table Readability & 1-Line Clean Alignment --- */
    table {
      width: 100% !important;
      border-collapse: collapse !important;
      border: 1px solid var(--border-color) !important;
      border-radius: 8px !important;
      overflow: hidden !important;
      background-color: var(--bg-card) !important;
      margin: 16px 0 !important;
    }

    th {
      background-color: var(--bg-card-hover) !important;
      color: var(--text-main) !important;
      border-bottom: 1px solid var(--border-color) !important;
      font-weight: 700 !important;
      font-size: 13.5px !important;
      padding: 10px 14px !important;
      white-space: nowrap !important;
      word-break: keep-all !important;
    }

    td {
      border-bottom: 1px solid var(--border-color) !important;
      padding: 9px 14px !important;
      font-size: 13.5px !important;
      line-height: 1.5 !important;
      vertical-align: middle !important;
    }

    /* Prevent breaking key table columns into 2 lines */
    td:first-child,
    td:nth-child(2) {
      word-break: keep-all !important;
    }

    /* Code, Symbols, and Conditions inside tables should NEVER wrap */
    table code {
      white-space: nowrap !important;
      font-family: 'JetBrains Mono', monospace !important;
      font-size: 12.5px !important;
      padding: 2px 6px !important;
      border-radius: 4px !important;
      background-color: var(--bg-card-hover) !important;
      border: 1px solid var(--border-color) !important;
    }

    /* --- [KEY FIX 2] Schema Parameter Table: Property Name + Required Badge 1-Line Flex --- */
    td[kind="field"] {
      white-space: nowrap !important;
      min-width: 160px !important;
    }

    td[kind="field"] > div,
    td[kind="field"] .property-name {
      display: inline-flex !important;
      align-items: center !important;
      gap: 6px !important;
      font-family: 'JetBrains Mono', monospace !important;
      font-size: 13.5px !important;
      font-weight: 600 !important;
      white-space: nowrap !important;
    }

    /* Required Badge inside schema tables: side-by-side on 1 line */
    td[kind="field"] div[class*="required"],
    td[kind="field"] span[class*="required"] {
      display: inline-block !important;
      font-size: 11px !important;
      font-weight: 700 !important;
      padding: 1px 6px !important;
      border-radius: 4px !important;
      margin-left: 6px !important;
      margin-top: 0 !important;
      vertical-align: middle !important;
      white-space: nowrap !important;
    }

    /* Schema Type & Format Labels (e.g. string <email>, number) */
    td span[class*="hhCpbw"],
    td span[class*="fIGxvH"],
    td div > span {
      white-space: nowrap !important;
    }

    /* Enum Badges in Schema */
    span[class*="cNHQfj"],
    span[class*="enum"] {
      white-space: nowrap !important;
      display: inline-block !important;
      margin-right: 4px !important;
      margin-bottom: 2px !important;
    }

    /* Right Side Code Block Panel */
    [data-theme="dark"] .redoc-wrap [role="region"] {
      background-color: #0b1120 !important;
    }

    /* Hide Redoc internal duplicate Copy button if custom exists, or style Redoc copy button cleanly */
    div[class*="sc-gjLKRm"] button {
      border-radius: 6px !important;
      font-size: 12px !important;
      font-weight: 600 !important;
      transition: all 0.2s ease !important;
    }

    /* ==========================================================================
       5. Result Code Finder Modal (Clean & Polished)
       ========================================================================== */
    .pcins-modal-backdrop {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(15, 23, 42, 0.6);
      backdrop-filter: blur(8px);
      z-index: 100000;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
      animation: fadeIn 0.2s ease;
    }

    .pcins-modal-backdrop.active {
      display: flex;
    }

    .pcins-modal {
      background: var(--bg-modal);
      border: 1px solid var(--border-color);
      border-radius: 16px;
      width: 100%;
      max-width: 680px;
      max-height: 82vh;
      display: flex;
      flex-direction: column;
      box-shadow: var(--shadow-modal);
      overflow: hidden;
      animation: slideUp 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .pcins-modal-header {
      padding: 18px 24px;
      border-bottom: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: var(--bg-card);
    }

    .pcins-modal-title {
      font-size: 16.5px;
      font-weight: 700;
      color: var(--text-main);
      display: flex;
      align-items: center;
      gap: 8px;
      white-space: nowrap;
    }

    .pcins-modal-close {
      background: none;
      border: none;
      font-size: 20px;
      color: var(--text-muted);
      cursor: pointer;
      padding: 4px 8px;
      border-radius: 6px;
    }

    .pcins-modal-close:hover {
      color: var(--text-main);
      background: var(--bg-card-hover);
    }

    .pcins-search-bar {
      padding: 16px 24px;
      border-bottom: 1px solid var(--border-color);
      background: var(--bg-body);
    }

    .pcins-search-input {
      width: 100%;
      padding: 12px 16px;
      border-radius: 10px;
      border: 1px solid var(--border-strong);
      background: var(--bg-card);
      color: var(--text-main);
      font-size: 14.5px;
      outline: none;
      transition: all 0.2s ease;
      font-family: inherit;
    }

    .pcins-search-input:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px var(--primary-light);
    }

    .pcins-code-list {
      padding: 14px 24px;
      overflow-y: auto;
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 8px;
      background: var(--bg-body);
    }

    .pcins-code-item {
      display: flex;
      flex-direction: column;
      gap: 6px;
      padding: 12px 16px;
      border-radius: 10px;
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      cursor: pointer;
      transition: all 0.15s ease;
      box-shadow: var(--shadow-sm);
    }

    .pcins-code-item:hover {
      border-color: var(--primary);
      background: var(--bg-card-hover);
      transform: translateY(-1px);
      box-shadow: var(--shadow-md);
    }

    .pcins-code-item-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .pcins-code-badge {
      font-family: 'JetBrains Mono', monospace;
      font-size: 13px;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 6px;
      background: var(--primary-light);
      color: var(--primary);
      border: 1px solid var(--primary-border);
      white-space: nowrap;
    }

    .pcins-code-badge.success {
      background: #ecfdf5;
      color: #059669;
      border-color: #a7f3d0;
    }
    [data-theme="dark"] .pcins-code-badge.success {
      background: rgba(16, 185, 129, 0.14);
      color: #34d399;
      border-color: rgba(16, 185, 129, 0.3);
    }

    .pcins-code-badge.error {
      background: #fef2f2;
      color: #dc2626;
      border-color: #fecaca;
    }
    [data-theme="dark"] .pcins-code-badge.error {
      background: rgba(239, 68, 68, 0.14);
      color: #f87171;
      border-color: rgba(239, 68, 68, 0.3);
    }

    .pcins-code-desc {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-main);
      word-break: keep-all;
    }

    .pcins-code-details {
      font-size: 12.5px;
      color: var(--text-muted);
      line-height: 1.45;
      word-break: keep-all;
    }

    /* Scroll To Top Button */
    .pcins-scroll-top {
      position: fixed;
      bottom: 28px;
      right: 28px;
      width: 44px;
      height: 44px;
      background: var(--primary);
      color: #ffffff;
      border: none;
      border-radius: 50%;
      box-shadow: var(--shadow-lg);
      cursor: pointer;
      display: none;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      z-index: 99;
      transition: all 0.2s ease;
    }

    .pcins-scroll-top:hover {
      background: var(--primary-hover);
      transform: translateY(-3px);
      box-shadow: 0 8px 20px rgba(59, 130, 246, 0.4);
    }

    /* Toast Notification */
    .pcins-toast {
      position: fixed;
      bottom: 28px;
      left: 50%;
      transform: translateX(-50%) translateY(100px);
      background: #1e293b;
      color: #f8fafc;
      font-size: 13.5px;
      font-weight: 600;
      padding: 11px 22px;
      border-radius: 30px;
      border: 1px solid #334155;
      box-shadow: var(--shadow-lg);
      z-index: 100001;
      opacity: 0;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      display: flex;
      align-items: center;
      gap: 8px;
      white-space: nowrap;
    }

    [data-theme="dark"] .pcins-toast {
      background: #334155;
      border-color: #475569;
    }

    .pcins-toast.show {
      transform: translateX(-50%) translateY(0);
      opacity: 1;
    }

    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes slideUp {
      from { transform: translateY(16px); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }

    @media (max-width: 900px) {
      .pcins-account-badge {
        display: none;
      }
      .pcins-top-bar {
        padding: 0 16px;
      }
      [role="navigation"] {
        width: 100% !important;
      }
    }
  </style>
</head>

<body>
  <!-- Top Scroll Progress Indicator -->
  <div id="scroll-progress"></div>

  <!-- Top Global Header -->
  <header class="pcins-top-bar">
    <a href="#" class="pcins-brand">
      <div class="pcins-logo-badge">PCINS</div>
      <div class="pcins-brand-title">Payment Gateway API</div>
      <span class="pcins-version-tag">v1.0.5</span>
      <span class="pcins-spec-tag">OpenAPI 3.0</span>
    </a>

    <div class="pcins-nav-links">
      <!-- Test Account 1: Non-3DS -->
      <div class="pcins-account-badge" onclick="copyText('M000000187', 'NON-3DS Merchant ID (M000000187) 복사 완료!')" title="클릭하여 NON-3DS 테스트 ID 복사">
        <span class="badge-label">NON-3DS:</span> M000000187 <span class="copy-icon">📋</span>
      </div>

      <!-- Test Account 2: 3DS -->
      <div class="pcins-account-badge" onclick="copyText('M000000413', '3DS Merchant ID (M000000413) 복사 완료!')" title="클릭하여 3DS 테스트 ID 복사">
        <span class="badge-label">3DS:</span> M000000413 <span class="copy-icon">📋</span>
      </div>

      <!-- Quick Result Code Search Button -->
      <button class="pcins-action-btn" onclick="openResultCodeModal()">
        <span>🔍 Result Code</span>
        <kbd>Ctrl+K</kbd>
      </button>

      <!-- Theme Switcher -->
      <button class="pcins-theme-toggle" id="theme-toggle-btn" onclick="toggleTheme()" title="라이트/다크 모드 전환">
        🌙
      </button>
    </div>
  </header>

  <!-- Redoc Static Injected Content -->
  {{{redocHTML}}}

  <!-- Result Code Quick Finder Modal -->
  <div class="pcins-modal-backdrop" id="result-code-modal" onclick="closeResultCodeModal(event)">
    <div class="pcins-modal" onclick="event.stopPropagation()">
      <div class="pcins-modal-header">
        <div class="pcins-modal-title">
          <span>🛑 Result Code & Error Quick Finder</span>
        </div>
        <button class="pcins-modal-close" onclick="closeResultCodeModal()">&times;</button>
      </div>
      <div class="pcins-search-bar">
        <input 
          type="text" 
          id="code-search-input" 
          class="pcins-search-input" 
          placeholder="에러 코드(예: 916, 927) 또는 키워드(예: 한도, 누락)를 입력하세요..." 
          oninput="filterResultCodes()" 
          autocomplete="off"
        />
      </div>
      <div class="pcins-code-list" id="modal-code-list">
        <!-- Rendered dynamically by JavaScript -->
      </div>
    </div>
  </div>

  <!-- Scroll To Top Button -->
  <button class="pcins-scroll-top" id="scroll-top-btn" onclick="scrollToTop()" title="맨 위로 이동">
    ↑
  </button>

  <!-- Toast Notification Container -->
  <div class="pcins-toast" id="pcins-toast">
    <span id="toast-icon">✅</span>
    <span id="toast-message">복사되었습니다!</span>
  </div>

  <script>
    // Result Code Master Dataset (100% 1:1 with Apidog)
    const resultCodes = [
      { code: '000', type: 'success', summary: 'Approval Success', details: '결제/취소/인증 정상 승인 완료' },
      { code: '101', type: 'error', summary: 'Failed to enter continuous billing information', details: '연속과금(정기결제) 등록 정보 입력 실패' },
      { code: '200', type: 'success', summary: 'Request Connection / Mail sent successfully', details: '접속 요청 성공 / 메일 정상 발송' },
      { code: '611', type: 'error', summary: 'Your card exceeds the monthly limit. Contact your administrator.', details: '월간 카드 이용 한도 초과. 관리자 문의 필요' },
      { code: '612', type: 'error', summary: 'Your card exceeds the number of times you use it per month. Contact your administrator.', details: '월간 카드 이용 횟수 초과. 관리자 문의 필요' },
      { code: '711', type: 'error', summary: 'This card BIN cannot be used.', details: '사용 불가능한 카드 BIN 번호' },
      { code: '712', type: 'error', summary: 'Korean card payment is not possible', details: '한국 발행 카드 결제 불가 (해외 카드 전용 라인)' },
      { code: '713', type: 'error', summary: 'Risk card registration card, please try again with another card.', details: '리스크 관리 등록 카드 (도난/분실/이상거래 의심)' },
      { code: '900', type: 'error', summary: 'The message is not long enough.', details: '전문(Message) 길이 부족 / 패킷 누락' },
      { code: '901', type: 'error', summary: 'Connection Error. (VAN login failed / Invalid response data)', details: 'VAN사 로그인 실패(계정 오류) 또는 응답 데이터 이상' },
      { code: '902', type: 'error', summary: 'VAN approval failure (Currency mismatch)', details: '가맹점 설정 통화와 요청 결제 통화 불일치 (VAN 라인은 1개 통화만 지원)' },
      { code: '909', type: 'error', summary: 'Payment has already been made.', details: '이미 결제 완료된 중복 거래' },
      { code: '910', type: 'error', summary: 'This card number is registered to the risk transaction card. Payment is not possible.', details: '리스크 거래 등록 카드번호. 결제 불가' },
      { code: '911', type: 'error', summary: 'The one-time payment limit has been exceeded. Please contact the administrator.', details: '1회 결제 한도 초과. 관리자 문의 필요' },
      { code: '912', type: 'error', summary: 'The daily payment limit has been exceeded. Please contact the administrator.', details: '1일 결제 한도 초과. 관리자 문의 필요' },
      { code: '913', type: 'error', summary: 'The one-month payment limit has been exceeded. Please contact the administrator.', details: '1개월 결제 한도 초과. 관리자 문의 필요' },
      { code: '914', type: 'error', summary: 'The password does not match.', details: '가맹점 비밀번호(merchantPwd) 불일치' },
      { code: '915', type: 'error', summary: 'Merchant Agreement is not Live.', details: '가맹점 계약 상태 비활성 (Live 상태 아님)' },
      { code: '916', type: 'error', summary: 'Requirements not entered* (Missing mandatory parameter)', details: '필수 파라미터 미입력 (merchantID, cardNo, expireM, expireY, price, ref 등 누락)' },
      { code: '917', type: 'error', summary: 'Transaction information does not exist.', details: '해당 거래 정보 미존재 (주문번호/거래번호 확인)' },
      { code: '918', type: 'error', summary: 'Internet access is restricted. Please contact the administrator.', details: '인터넷 접속 제한 (IP 차단 또는 허용되지 않은 접근)' },
      { code: '919', type: 'error', summary: 'There is no payment information.', details: '결제 정보 없음' },
      { code: '920', type: 'error', summary: 'Exceeded limit', details: '카드사 한도 초과' },
      { code: '921', type: 'error', summary: 'Insufficient balance', details: '잔액 부족' },
      { code: '922', type: 'error', summary: 'Incorrect card holder', details: '카드 명의자 불일치' },
      { code: '923', type: 'error', summary: 'Incorrect card number', details: '유효하지 않은 카드 번호' },
      { code: '924', type: 'error', summary: 'Incorrect expiration date', details: '유효기간(MM/YY) 오류' },
      { code: '925', type: 'error', summary: 'Incorrect security code', details: '보안코드(CVV/CVC) 불일치' },
      { code: '926', type: 'error', summary: 'System error', details: '시스템 내부 오류' },
      { code: '927', type: 'error', summary: 'Card company approval rejected', details: '카드사 승인 거절 (도난/정지/한도 등)' },
      { code: '928', type: 'error', summary: 'Invalid card type', details: '유효하지 않은 카드 브랜드 타입' },
      { code: '929', type: 'error', summary: 'Stolen card', details: '도난/분실 신고된 카드' },
      { code: '931', type: 'error', summary: 'Please contact the card company.', details: '카드사 직접 문의 필요' },
      { code: '932', type: 'error', summary: 'Please enter the security code (CVV).', details: '보안코드(CVV) 미입력' },
      { code: '933', type: 'error', summary: 'Incorrect card type.', details: '카드 종류 선택 오류' },
      { code: '934', type: 'error', summary: 'This card is not eligible for the service.', details: '해당 서비스 미지원 카드' },
      { code: '935', type: 'error', summary: 'Acquirer decline.', details: '매입사 승인 거절' },
      { code: '936', type: 'error', summary: 'The minimum payment amount has not been met.', details: '최소 결제 금액 미달 (Yen / Dollar 최소금액 미충족)' },
      { code: '941', type: 'error', summary: 'This payment has already been refunded.', details: '이미 환불 완료되었거나 현재 환불 진행 중인 거래' },
      { code: '999', type: 'error', summary: 'Continuous charging has already been canceled.', details: '연속과금(정기결제) 이미 취소됨' }
    ];

    // Theme Management
    function initTheme() {
      try {
        const savedTheme = localStorage.getItem('pcins_theme') || 
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        setTheme(savedTheme);
      } catch (e) {
        setTheme('light');
      }
    }

    function toggleTheme() {
      const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
      const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
      setTheme(newTheme);
    }

    function setTheme(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      try {
        localStorage.setItem('pcins_theme', theme);
      } catch (e) {}
      const btn = document.getElementById('theme-toggle-btn');
      if (btn) {
        btn.innerHTML = theme === 'dark' ? '☀️' : '🌙';
      }
    }

    // Scroll Progress & Scroll to Top
    window.addEventListener('scroll', () => {
      const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
      const bar = document.getElementById('scroll-progress');
      if (bar) bar.style.width = scrolled + '%';

      const topBtn = document.getElementById('scroll-top-btn');
      if (topBtn) {
        topBtn.style.display = winScroll > 300 ? 'flex' : 'none';
      }
    });

    function scrollToTop() {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Toast Notification
    function showToast(message, icon = '✅') {
      const toast = document.getElementById('pcins-toast');
      const msg = document.getElementById('toast-message');
      const ic = document.getElementById('toast-icon');
      if (toast && msg) {
        msg.textContent = message;
        if (ic) ic.textContent = icon;
        toast.classList.add('show');
        setTimeout(() => toast.classList.remove('show'), 2500);
      }
    }

    // Robust Clipboard Copy with Fallback
    function copyText(text, successMsg = '클립보드에 복사되었습니다!') {
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(text).then(() => {
          showToast(successMsg);
        }).catch(() => {
          fallbackCopyText(text, successMsg);
        });
      } else {
        fallbackCopyText(text, successMsg);
      }
    }

    function fallbackCopyText(text, successMsg) {
      try {
        const textArea = document.createElement('textarea');
        textArea.value = text;
        textArea.style.position = 'fixed';
        textArea.style.left = '-999999px';
        textArea.style.top = '-999999px';
        document.body.appendChild(textArea);
        textArea.focus();
        textArea.select();
        const successful = document.execCommand('copy');
        document.body.removeChild(textArea);
        if (successful) {
          showToast(successMsg);
        }
      } catch (err) {
        console.error('Fallback copy failed: ', err);
      }
    }

    // Result Code Modal
    function openResultCodeModal() {
      const modal = document.getElementById('result-code-modal');
      const input = document.getElementById('code-search-input');
      if (modal) {
        modal.classList.add('active');
        renderResultCodes(resultCodes);
        if (input) {
          input.value = '';
          setTimeout(() => input.focus(), 100);
        }
      }
    }

    function closeResultCodeModal(e) {
      const modal = document.getElementById('result-code-modal');
      if (modal) modal.classList.remove('active');
    }

    function renderResultCodes(list) {
      const container = document.getElementById('modal-code-list');
      if (!container) return;
      
      if (!list || list.length === 0) {
        container.innerHTML = '<div style="text-align:center; padding: 30px; color: var(--text-muted);">일치하는 에러 코드가 없습니다.</div>';
        return;
      }

      container.innerHTML = list.map(item => `
        <div class="pcins-code-item" onclick="copyText('${item.code}', '에러 코드 [${item.code}] 복사 완료!')">
          <div class="pcins-code-item-header">
            <span class="pcins-code-badge ${item.type}">${item.code}</span>
            <span style="font-size: 11px; color: var(--text-dim);">클릭하여 코드 복사 📋</span>
          </div>
          <div class="pcins-code-desc">${item.summary}</div>
          <div class="pcins-code-details">${item.details}</div>
        </div>
      `).join('');
    }

    function filterResultCodes() {
      const input = document.getElementById('code-search-input');
      const query = input ? input.value.toLowerCase().trim() : '';
      const filtered = resultCodes.filter(item => 
        item.code.toLowerCase().includes(query) ||
        item.summary.toLowerCase().includes(query) ||
        item.details.toLowerCase().includes(query)
      );
      renderResultCodes(filtered);
    }

    // Global Keydown Handler (Ctrl+K, ESC)
    document.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        openResultCodeModal();
      } else if (e.key === 'Escape') {
        closeResultCodeModal();
      }
    });

    document.addEventListener('DOMContentLoaded', () => {
      initTheme();
    });
  </script>
</body>

</html>
